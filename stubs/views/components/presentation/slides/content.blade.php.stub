@props([
    'slide' => [],
    'slideIndex' => 0,
    'totalSlides' => 1,
])

<x-presentation::slide :theme="$slide['theme']" :slide-index="$slideIndex" :total-slides="$totalSlides"
                        :footer="$slide['footer'] ?? ''" :slide-id="$slide['id']">
    <h2 contenteditable="true" class="slide-title" style="color: #1a1a2e;"
        data-override-key="{{ $slide['id'] }}.title" @blur="saveOverride($event)">{{ $slide['title'] }}</h2>
    <p contenteditable="true" class="slide-subtitle" style="color: #6B7280;"
       data-override-key="{{ $slide['id'] }}.subtitle" @blur="saveOverride($event)">{{ $slide['subtitle'] }}</p>
    <div class="slide-content">
        {{-- Dein Inhalt hier --}}
    </div>
</x-presentation::slide>
