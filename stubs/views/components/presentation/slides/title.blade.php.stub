@props([
    'slide' => [],
    'slideIndex' => 0,
    'totalSlides' => 1,
    'mode' => 'present',
])

<x-presentation::slide :theme="$slide['theme']" :slide-index="$slideIndex" :total-slides="$totalSlides"
                       :footer="$slide['footer'] ?? ''" :slide-id="$slide['id']" :mode="$mode">
    <h1 class="slide-title edit-hidden"
        style="position: absolute; left: 56px; right: 56px; top: 330px; margin: 0; font-size: 42px; line-height: 1.2; color: #fff; text-align: center;">{{ $slide['title'] }}</h1>
    <p class="slide-subtitle edit-hidden"
       style="position: absolute; left: 56px; right: 56px; top: 385px; margin: 0; font-size: 18px; line-height: 1.4; color: #9CA3AF; text-align: center;">{{ $slide['subtitle'] }}</p>
    <div style="flex: 1;"></div>
</x-presentation::slide>
