@props([
    'slide' => [],
    'slideIndex' => 0,
    'totalSlides' => 1,
])

<x-presentation::slide :theme="$slide['theme']" :slide-index="$slideIndex" :total-slides="$totalSlides"
                        :footer="$slide['footer'] ?? ''" :slide-id="$slide['id']">
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
        <h1 contenteditable="true" class="slide-title" style="font-size: 42px; color: #fff;"
            data-override-key="{{ $slide['id'] }}.title" @blur="saveOverride($event)">{{ $slide['title'] }}</h1>
        <p contenteditable="true" class="slide-subtitle" style="font-size: 18px; color: #9CA3AF; margin-bottom: 32px;"
           data-override-key="{{ $slide['id'] }}.subtitle" @blur="saveOverride($event)">{{ $slide['subtitle'] }}</p>
    </div>
</x-presentation::slide>
