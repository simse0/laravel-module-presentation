{{-- 
    Diese View extended die Package-Engine und rendert deine Slides.
    Passe den @switch-Block an deine Slide-Typen an.
--}}
@extends('presentation::engine')

@section('slides')
    @foreach($slides as $idx => $slide)
        @switch($slide['type'])
            @case('title')
                <x-presentation.slides.title :slide="$slide" :slide-index="$idx" :total-slides="count($slides)" />
                @break
            @case('content')
                <x-presentation.slides.content :slide="$slide" :slide-index="$idx" :total-slides="count($slides)" />
                @break
            {{-- Füge hier eigene Slide-Typen hinzu --}}
        @endswitch
    @endforeach
@endsection

@push('presentation-scripts')
<script>
{{-- 
    Falls du Charts brauchst (z.B. ApexCharts), überschreibe hier renderChartsForSlide:

    document.addEventListener('alpine:init', () => {
        const origFunc = presentationEngine;
        window.presentationEngine = function() {
            const engine = origFunc();
            engine.renderChartsForSlide = function(idx) {
                // Chart-Rendering-Logik hier
            };
            return engine;
        };
    });
--}}
</script>
@endpush
